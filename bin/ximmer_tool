#!/bin/bash

BASE=`cd $(dirname $0 | xargs dirname); pwd`

# Workaround for docker install not finding Java
if [ -e /.dockerenv ];
then
    export JAVA_HOME=/root/.sdkman/candidates/java/current
    export PATH="$JAVA_HOME/bin:$PATH"
fi

unset GROOVY_HOME

if [ ! -z "$XIMMER_REF" ];
then
    echo "Using reference sequence: $XIMMER_REF"
    $BASE/bin/install --set-reference $XIMMER_REF
fi

# Set JAVA_HOME based on java location
if [ -z "$JAVA_HOME" ];
then
    export JAVA_HOME=`dirname $(which java) | xargs dirname`
fi

: ${XIMMER_MEM:=20g}
JAVA_OPTS="-Xmx$XIMMER_MEM -noverify -Dsamjdk.reference_fasta=$XIMMER_REF -Dsnappy.disable=true -Djava.io.tmpdir=./.ximmertmp -Dximmer.base=$BASE"

export JAVA_OPTS

mkdir -p .ximmertmp

tool="$1"

shift

if [ "$1" == "install" ];
then
    $BASE/tools/bpipe/0.9.12/bin/bpipe install $BASE/pipeline/exome_cnv_pipeline.groovy 
else

    if [ -e $BASE/src/main/groovy/ximmer/${tool}.groovy ];
    then
        TOOLPATH="$BASE/src/main/groovy/ximmer/${tool}.groovy"
    elif [ -e $BASE/src/main/groovy/${tool}.groovy ];
    then
        TOOLPATH="$BASE/src/main/groovy/${tool}.groovy"
    else
        echo
        echo "No tool calld $tool was found"
        echo
        exit 1
    fi

        $BASE/tools/groovy/3.0.10/bin/groovy \
        -cp $BASE/src/main/groovy:$BASE/src/main/resources:$BASE/tools/groovy-ngs-utils/1.0.9/groovy-ngs-utils.jar \
            $TOOLPATH $*
fi

